{
  "name": "agentkeeper",
  "version": "1.0.0",
  "description": "Confine AI coding agents to what they need: OS-level sandboxing plus a thin detection layer. No Docker, no daemon in the cloud, no telemetry.",
  "keywords": [
    "ai-agent",
    "security",
    "sandbox",
    "seatbelt",
    "bubblewrap",
    "prompt-injection",
    "claude-code",
    "supply-chain"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovelasxyz/agentkeeper.git"
  },
  "homepage": "https://github.com/lovelasxyz/agentkeeper#readme",
  "bugs": {
    "url": "https://github.com/lovelasxyz/agentkeeper/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "bin": {
    "agentkeeper": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "profiles",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build:windows-sandbox": "node scripts/build-windows-sandbox.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:watch": "vitest",
    "test:sandbox": "vitest run --project sandbox",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "coverage": "vitest run --project unit --project integration --coverage",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint:arch && npm run coverage && npm run test:sandbox",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm run verify:package",
    "bench": "npm run build && node test/e2e/bench.mjs dist/cli.js",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.9.0",
    "esbuild": "^0.28.1",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
