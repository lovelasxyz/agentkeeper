{
  "id": "infra",
  "name": "Infrastructure",
  "description": "Terraform, Kubernetes and container tooling. Note what is NOT here: ~/.aws, ~/.kube and ~/.docker hold credentials and stay tier 2 — see README, \"The two tiers\".",
  "reads": [
    "file:~/.gitconfig",
    "dir:~/.config/git",
    "dir:~/.terraform.d/plugin-cache",
    "dir:~/.cache/helm",
    "dir:~/.krew",
    "dir:~/.npm"
  ],
  "writes": [
    "dir:~/.terraform.d/plugin-cache",
    "dir:~/.cache/helm"
  ],
  "network": [
    "*.anthropic.com:443",
    "claude.ai:443",
    "*.claude.ai:443",
    "*.openai.com:443",
    "chatgpt.com:443",
    "*.chatgpt.com:443",
    "*.googleapis.com:443",
    "accounts.google.com:443",
    "openrouter.ai:443",
    "github.com:443",
    "*.github.com:443",
    "*.githubusercontent.com:443",
    "registry.npmjs.org:443",
    "registry.terraform.io:443",
    "releases.hashicorp.com:443",
    "charts.helm.sh:443"
  ]
}
