{
  "id": "python",
  "name": "Python and data work",
  "description": "pip, uv, poetry, conda caches and Jupyter configuration.",
  "reads": [
    "file:~/.gitconfig",
    "dir:~/.config/git",
    "dir:~/.cache/pip",
    "dir:~/Library/Caches/pip",
    "dir:~/.cache/uv",
    "dir:~/.cache/pypoetry",
    "dir:~/.local/lib",
    "dir:~/.pyenv/versions",
    "dir:~/.jupyter",
    "dir:~/.ipython",
    "dir:~/.conda"
  ],
  "writes": [
    "dir:~/.cache/pip",
    "dir:~/Library/Caches/pip",
    "dir:~/.cache/uv",
    "dir:~/.cache/pypoetry",
    "dir:~/.ipython"
  ],
  "network": [
    "*.anthropic.com:443",
    "claude.ai:443",
    "*.claude.ai:443",
    "*.openai.com:443",
    "chatgpt.com:443",
    "*.chatgpt.com:443",
    "*.googleapis.com:443",
    "accounts.google.com:443",
    "openrouter.ai:443",
    "github.com:443",
    "*.github.com:443",
    "*.githubusercontent.com:443",
    "pypi.org:443",
    "*.pypi.org:443",
    "*.pythonhosted.org:443"
  ]
}
