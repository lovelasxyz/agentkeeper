{
  "id": "web",
  "name": "Web development",
  "description": "Node, package managers, git and the usual editor configuration.",
  "reads": [
    "file:~/.gitconfig",
    "dir:~/.config/git",
    "dir:~/.npm",
    "dir:~/.cache/yarn",
    "dir:~/Library/Caches/Yarn",
    "dir:~/.cache/pnpm",
    "dir:~/Library/pnpm",
    "dir:~/.bun/install/cache",
    "dir:~/.config/nvim",
    "dir:~/.vscode/extensions",
    "dir:~/.local/share/pnpm/store"
  ],
  "writes": [
    "dir:~/.npm/_cacache",
    "dir:~/.npm/_logs",
    "dir:~/.cache/pnpm",
    "dir:~/.cache/yarn",
    "dir:~/Library/Caches/Yarn"
  ],
  "network": [
    "*.anthropic.com:443",
    "claude.ai:443",
    "*.claude.ai:443",
    "*.openai.com:443",
    "chatgpt.com:443",
    "*.chatgpt.com:443",
    "*.googleapis.com:443",
    "accounts.google.com:443",
    "openrouter.ai:443",
    "github.com:443",
    "*.github.com:443",
    "*.githubusercontent.com:443",
    "registry.npmjs.org:443",
    "*.npmjs.org:443",
    "registry.yarnpkg.com:443"
  ]
}
